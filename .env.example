# Local vLLM server hosting one of the four self-hosted models at a time
# (Gemma-3-27B, Mistral-Small-3.2-24B, Qwen2.5-VL-32B, InternVL2.5-26B) —
# see hosting/*.sh.
LOCAL_VLM_URL=http://<host>:8000/v1

# OpenRouter — used for Grok-4.20 generation, the Gemini-3-Flash node-matching
# judge, and the pairwise conclusion-match judge (scripts/conclusion_match.py).
# These are paid API calls; see the README for a cost estimate.
OPENROUTER_API_KEY=...
